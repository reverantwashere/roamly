{
  "name": "roamly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "node scripts/check-hosted-config.mjs && tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js src/lib/*.test.mjs scripts/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.468.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/leaflet": "^1.9.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
