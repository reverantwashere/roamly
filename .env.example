# Public browser settings. These are safe to expose, but never add a service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Local Express security settings. They are only needed while running the legacy
# local API during the Supabase migration; do not set them in Cloudflare Pages.
# APP_ORIGIN=http://localhost:5173
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM=Roamly <hello@your-domain.example>
